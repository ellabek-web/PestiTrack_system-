{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 200,
    "AuthPermitLimitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false,
    "TerminateTlsExternally": false
  }
}
