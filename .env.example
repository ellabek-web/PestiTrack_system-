# Copy this file to .env and replace placeholder values before running docker compose.

# Strong SQL Server SA password (min 8 chars, upper, lower, digit, symbol)
SQL_SA_PASSWORD=ChangeMe_StrongP@ssword1!
SQL_DATABASE=PestiTrackDb
SQL_PORT=1433

# Exposed host ports for Docker Compose
BACKEND_PORT=8080
FRONTEND_HTTP_PORT=8081
FRONTEND_HTTPS_PORT=8443

# Rate limiting (per IP per minute)
RATE_LIMIT_GLOBAL_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=10

# One-time administrator bootstrap credentials (used only with --bootstrap-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_PASSWORD=ChangeMe_Admin123!
