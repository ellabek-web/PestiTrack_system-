# Copy this file to .env and replace placeholder values before running docker compose.
# NEVER commit a real .env — it holds passwords and the cloud database URL.

# ── Which database? ──────────────────────────────────────────────────
# SqlServer  = local SQL Server (docker-compose.yml, the original setup)
# PostgreSql = local Postgres (docker-compose.postgres.yml) or Neon /
#              Supabase in the cloud. Auto-detects from the connection
#              string / DATABASE_URL when set to Auto (the default).
DATABASE_PROVIDER=Auto

# ── SQL Server (local) ──────────────────────────────────────────────
# Strong SQL Server SA password (min 8 chars, upper, lower, digit, symbol)
SQL_SA_PASSWORD=ChangeMe_StrongP@ssword1!
SQL_DATABASE=PestiTrackDb
SQL_PORT=1433

# ── PostgreSQL (local docker, or Neon / Supabase in the cloud) ──────
# Local docker Postgres (docker-compose.postgres.yml):
PG_USER=postgres
PG_PASSWORD=ChangeMe_StrongP@ssword1!
PG_DATABASE=PestiTrackDb
PG_PORT=5433
# Cloud (Neon / Supabase): paste the postgres:// URL they give you.
# On Render this is set as the DATABASE_URL env var instead of in .env.
# Example: postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Exposed host ports for Docker Compose
BACKEND_PORT=8080
FRONTEND_HTTP_PORT=8081
FRONTEND_HTTPS_PORT=8443

# Rate limiting (per IP per minute)
RATE_LIMIT_GLOBAL_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=10

# One-time administrator bootstrap credentials (used only with --bootstrap-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_PASSWORD=ChangeMe_Admin123!
